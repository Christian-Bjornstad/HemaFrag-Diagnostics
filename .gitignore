# Trained ML model artifacts (joblib binaries) — local only.
# Per-assay metadata.json is committed for audit; the .joblib lives
# on the chemist's laptop and is regenerated by train_clonality_interpretation_models.py.
# Plan 11 / ObsidianVault/Clonality_ML_Log/models/.
*.joblib
ObsidianVault/**/models/**/*.joblib

# Local clonality ML audits and raw-derived feature artifacts. These may
# contain clinical identifiers, local paths, or provenance fingerprints.
clonality_ml_audit/
clonality_ml_features/

